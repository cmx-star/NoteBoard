{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Loomark",
  "version": "0.8.5",
  "identifier": "com.starcmx.loomark",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1421",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "nb-main",
        "title": "Loomark",
        "width": 1200,
        "height": 800,
        "minWidth": 680,
        "minHeight": 480,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "visible": false,
        "dragDropEnabled": true,
        "devtools": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' blob: 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost https://asset.localhost data: blob: https: http:; font-src 'self' blob: asset: http://asset.localhost https://asset.localhost data:; connect-src 'self' ipc: http://ipc.localhost blob: asset: http://asset.localhost https://asset.localhost https://www.plantuml.com/plantuml/svg/ https://cdn.jsdelivr.net/gh/NateScarlet/holiday-cn@master/ https://raw.githubusercontent.com/NateScarlet/holiday-cn/master/; worker-src 'self' blob:; frame-src https://embed.diagrams.net",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "doc",
          "docx",
          "xls",
          "xlsx",
          "ppt",
          "pptx",
          "pdf",
          "dwg",
          "dxf",
          "epub",
          "note",
          "goodnotes"
        ],
        "name": "Loomark.DocumentPreview",
        "description": "Loomark 只读文档预览",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Loomark.Markdown",
        "description": "Loomark Markdown 笔记",
        "rank": "Alternate"
      },
      {
        "ext": [
          "txt"
        ],
        "name": "Loomark.Text",
        "description": "Loomark 文本文件",
        "rank": "Alternate"
      },
      {
        "ext": [
          "sql"
        ],
        "name": "Loomark.Sql",
        "description": "Loomark SQL 文件",
        "rank": "Alternate"
      },
      {
        "ext": [
          "json"
        ],
        "name": "Loomark.Json",
        "description": "Loomark JSON 文件",
        "rank": "Alternate"
      },
      {
        "ext": [
          "yaml",
          "yml"
        ],
        "name": "Loomark.Yaml",
        "description": "Loomark YAML 文件",
        "rank": "Alternate"
      },
      {
        "ext": [
          "xml"
        ],
        "name": "Loomark.Xml",
        "description": "Loomark XML 文件",
        "rank": "Alternate"
      },
      {
        "ext": [
          "excalidraw",
          "board",
          "canvas"
        ],
        "name": "Loomark.Board",
        "description": "Loomark 画板",
        "rank": "Alternate"
      },
      {
        "ext": [
          "png",
          "jpg",
          "jpeg",
          "gif",
          "webp",
          "ico",
          "svg",
          "bmp"
        ],
        "name": "Loomark.Image",
        "description": "Loomark 图片",
        "rank": "Alternate"
      }
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installerHooks": "resources/nsis/hooks.nsh",
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    }
  },
  "plugins": {}
}
